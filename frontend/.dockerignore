# Frontend build-context exclusions.
#
# The frontend Dockerfile uses context: ./frontend (docker-compose.yml),
# so a context-scoped .dockerignore must live here — the repo-root
# .dockerignore is ignored for this build.
#
# Without this file, every build COPYs the host's node_modules/
# (300+ MB of platform-specific binaries) and dist/ into the build
# context, slowing the build and risking host/container mismatches
# (Windows .node files leaking into the Linux image).

node_modules/
dist/
.vite/

# IDE + OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Git + CI state
.git/
.gitignore

# Local env files that shouldn't bake into images
.env
.env.local
.env.*.local

# Logs / debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
