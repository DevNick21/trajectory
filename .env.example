# AskPicky — example environment file.
# Copy to .env and fill in the real values. .env is gitignored.

# ---- credentials (required) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=12345:abc...
COMPANIES_HOUSE_API_KEY=...

# Multi-provider LLM keys (2026-05-23).
# DeepSeek V4 Flash — low-stakes extraction/routing/triage. Anthropic-
# compatible endpoint; same SDK, different base_url. ~$0.14/$0.28 per Mtok.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Firecrawl — anti-bot page scraping fallback (Glassdoor, Indeed, LinkedIn).
# 1 credit/page. Free tier = 1,000 pages/month. Only fires when Playwright
# is blocked — not every scrape. https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# Optional: alternative providers for CV tailoring / benchmarking.
# Only required if ENABLE_MULTI_PROVIDER_CV_TAILOR=true or running live benchmarks.
OPENAI_API_KEY=sk-proj-...

# ---- dual-surface identity (required for the API) ------------------------
# Single-user demo: both surfaces resolve to the same user_profiles row
# keyed by this value. Set it to your numeric Telegram user id (the same
# value `update.effective_user.id` returns).
DEMO_USER_ID=

# ---- web surface (optional — defaults shown) -----------------------------
API_PORT=8000
# CORS allowlist for the FastAPI app. Strict — no wildcards.
WEB_ORIGIN=http://localhost:5173
# Public URL the bot points un-onboarded users at (Wave 10).
WEB_URL=http://localhost:5173

# ---- feature flags --------------------------------------------------------
# Telegram per-user rate limiting.
ENFORCE_RATE_LIMIT=false

# Pre-verdict triage (architecture gap #4). A ~$0.01 DeepSeek Flash call
# classifies forwards as SERIOUS/EXPLORATORY/DEFINITE_PASS before the full
# Phase 1 pipeline. DEFINITE_PASS skips the pipeline entirely. Single biggest
# cost-leverage move.
ENABLE_TRIAGE_BEFORE_VERDICT=true

# ---- queue + cost knobs (default off) -------------------------------------
# Route /api/queue/process through the Anthropic Batch API (50% discount,
# async). Currently a credential-ping; full per-step batching lands in a
# follow-up handle_forward_job refactor.
ENABLE_BATCH_QUEUE_RUNNER=false

# ---- multi-provider CV tailor (PROCESS Entry 44) --------------------------
# When True, /draft_cv routes to the LLM provider mapped from the job URL's
# ATS host. Provider misconfig (missing API key) falls back to Anthropic.
ENABLE_MULTI_PROVIDER_CV_TAILOR=false

# LangGraph orchestrator — wraps handle_forward_job as a StateGraph with
# checkpointed state, retry, and structured error handling. Domain logic
# stays in the existing modules. Opt-in — off by default.
ENABLE_LANGGRAPH_ORCHESTRATOR=false

# ---- benchmark / CI -------------------------------------------------------
# Set to 1 in CI to skip live benchmark calls and use fixture pass/fail.
# Unset locally to exercise real API keys.
# SMOKE_TEST_MOCK=1
