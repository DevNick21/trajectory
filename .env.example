# AskPicky — example environment file.
# Copy to .env and fill in the real values. .env is gitignored.

# ---- credentials (required) -----------------------------------------------
COMPANIES_HOUSE_API_KEY=...

# DeepSeek — primary LLM provider (OpenAI-compatible endpoint).
# V4 Flash for fast/triage, V4 Pro for normal/generation.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# OpenAI — GPT-5.4 for strong-tier verdict / benchmark.
OPENAI_API_KEY=sk-proj-...

# Firecrawl — anti-bot page scraping fallback (Glassdoor, Indeed, LinkedIn).
# 1 credit/page. Free tier = 1,000 pages/month. Only fires when Playwright
# is blocked — not every scrape. https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# ---- local identity -------------------------------------------------------
# Open-core/self-hosted mode runs with one local user identity.
DEMO_USER_ID=

# Privacy retention jobs.
PRIVACY_PURGE_INTERVAL_HOURS=24
PRIVACY_PURGE_ON_STARTUP=true

# ---- web surface (optional — defaults shown) -----------------------------
API_PORT=8000
# CORS allowlist for the FastAPI app. Strict — no wildcards.
WEB_ORIGIN=http://localhost:5173

# ---- feature flags --------------------------------------------------------
# Pre-verdict triage. A ~$0.01 DeepSeek Flash call classifies forwards
# as SERIOUS/EXPLORATORY/DEFINITE_PASS before the full Phase 1 pipeline.
ENABLE_TRIAGE_BEFORE_VERDICT=true

# LangGraph orchestrator — wraps handle_forward_job as a StateGraph with
# checkpointed state, retry, and structured error handling. Opt-in.
ENABLE_LANGGRAPH_ORCHESTRATOR=false

# ---- benchmark / CI -------------------------------------------------------
# Set to 1 in CI to skip live benchmark calls and use fixture pass/fail.
# Unset locally to exercise real API keys.
# SMOKE_TEST_MOCK=1
